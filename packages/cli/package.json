{
  "name": "@croffledev/croffle-cli",
  "version": "1.1.2",
  "description": "CLI for scaffolding, building, and packaging Croffle extensions",
  "type": "module",
  "bin": {
    "create-croffle-plugin": "dist/cli.js",
    "croffle-plugin": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm",
    "dev": "tsup src/cli.ts --format esm --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "commander": "^13.1.0",
    "fs-extra": "^11.3.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.3.6",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/team-croffle/croffle.git",
    "directory": "packages/cli"
  }
}
