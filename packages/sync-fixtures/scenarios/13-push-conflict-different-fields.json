    {
      "id": "acct-1",
      "username": "alice",
      "teams": ["team-default"]
    }
  ],
  "devices": [
    {
      "id": "client-1",
      "accountId": "acct-1"
    },
    {
      "id": "client-2",
      "accountId": "acct-1"
    }
  ],
  "steps": [
