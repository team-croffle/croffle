          "commits": [
            {
              "opId": "op-1",
              "table": "schedule",
              "rowId": "row-1",
              "op": "upsert",
              "baseVersion": 0,
              "version": 1,
              "updatedAtMs": 1700000000000,
              "lastWriterId": "device:client-1",
              "row": {
                "id": "row-1",
                "title": "standup",
                "startDate": 1700003600000,
                "ownerId": "acct-1",
                "teamId": null,
                "deletedAt": null,
                "version": 1,
                "updatedAtMs": 1700000000000
              }
            }
          ]
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "accepted": ["op-1"]
        }
      }
    },
    {
