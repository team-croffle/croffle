{
  "name": "@croffledev/croffle",
  "private": true,
  "version": "1.1.1-rc.2",
  "description": "Croffle monorepo",
  "author": {
    "name": "Croffle Dev.",
    "email": "support@croffledev.kr"
  },
  "homepage": "https://github.com/team-croffle",
  "scripts": {
    "format": "oxfmt --write .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "husky",
    "typecheck": "pnpm -r --parallel run typecheck",
    "typecheck:desktop": "pnpm --filter @croffledev/desktop typecheck",
    "dev": "pnpm --filter @croffledev/desktop dev",
    "start": "pnpm --filter @croffledev/desktop start",
    "build": "pnpm --filter @croffledev/desktop build",
    "build:unpack": "pnpm --filter @croffledev/desktop build:unpack",
    "build:win": "pnpm --filter @croffledev/desktop build:win",
    "build:mac": "pnpm --filter @croffledev/desktop build:mac",
    "build:linux": "pnpm --filter @croffledev/desktop build:linux",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter @croffledev/croffle-cli build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@swc/core": "^1.15.46",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "6.0.3",
    "vue-eslint-parser": "^10.4.1"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,ts,tsx,mts,cts,vue}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --write"
    ],
    "*.{json,md,yml,yaml}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0"
}
